// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(FAMILY)
  createdAt     DateTime  @default(now())
  lastSignIn    DateTime?
  
  accounts Account[]
  sessions Session[]
  storyViews StoryView[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model StoryView {
  id        String   @id @default(cuid())
  userId    String
  storySlug String
  viewedAt  DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, storySlug])
}

model StorySubmission {
  id               String   @id @default(cuid())
  userId           String
  userEmail        String   // User email who submitted
  userName         String?  // User name for display
  storyNumber      Int
  title            String
  content          String   @db.Text // The raw MDX content
  imageCount       Int      @default(0)
  prUrl            String   // GitHub PR URL
  prNumber         Int      // GitHub PR number
  branchName       String   // GitHub branch name
  status           String   @default("pending") // pending, published, rejected
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  @@index([userId])
  @@index([userEmail])
  @@index([status])
  @@index([createdAt])
}

enum Role {
  ADMIN
  FAMILY
  GUEST
}
