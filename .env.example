# ===========================================
# Remembering Ryan - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in the values.

# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/remembering_ryan"

# --- NextAuth ---
NEXTAUTH_SECRET="generate-a-random-secret-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# --- Google OAuth (NextAuth provider) ---
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- GitHub (for story submission PRs) ---
# Personal access token with repo scope
GITHUB_TOKEN=""
GITHUB_REPO_OWNER="jemustain"
GITHUB_REPO_NAME="remembering-ryan"

# --- GitHub Webhooks ---
# Secret configured in GitHub repo webhook settings
# Used to verify incoming webhook signatures
GITHUB_WEBHOOK_SECRET=""

# --- Admin Configuration ---
# Comma-separated list of email addresses that get ADMIN role on first sign-in
ADMIN_EMAILS="admin@example.com"
